{
  "specVersion": "0.2.0",
  "name": "dsh-session-assistant",
  "pluginTypes": ["F1", "F3"],
  "facts": {
    "modelVisible": true,
    "registersTools": false,
    "filesystem": "write",
    "persistentState": true,
    "subprocess": false,
    "subagents": false,
    "temporaryResources": false,
    "customProtocol": false
  },
  "package": { "path": "package.json" },
  "model": {
    "dir": "dsh/model",
    "readme": "dsh/model/README.md",
    "files": [
      { "path": "prompt.js", "export": "PROMPT", "role": "staticText" },
      { "path": "tool-surface.js", "export": "SESSION_ASSISTANT_TOOLS", "role": "toolSurface", "toolName": "submit_to_agent", "helpPointer": "dsh/model/README.md" },
      { "path": "tool-surface.js", "export": "SESSION_ASSISTANT_TOOL_OUTPUT", "role": "contract", "contractKind": "toolOutput" }
    ]
  },
  "help": {
    "file": "dsh/help.js",
    "versionExport": "VERSION",
    "commands": ["discuss", "draft", "finalize", "submit", "end"]
  },
  "tests": {
    "contractTests": [
      { "file": "test/session-assistant.test.mjs", "references": ["PROMPT", "SESSION_ASSISTANT_TOOLS", "SESSION_ASSISTANT_TOOL_OUTPUT"] }
    ],
    "runtimeTests": [
      { "file": "test/session-assistant.test.mjs", "layer": "L1" },
      { "file": "test/session-assistant.test.mjs", "layer": "L2" }
    ]
  },
  "contracts": [
    { "name": "session-assistant-profile", "file": "spec/session-assistant-contract.json", "versionField": "version" }
  ]
}
