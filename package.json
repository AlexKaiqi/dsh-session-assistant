{
  "name": "dsh-chatvoice",
  "version": "0.1.0",
  "description": "ChatVoice — free voice input + AI reply read-aloud for DeepSeek Harness (dsh). Zero config, zero cost, no API key, built on the browser's native Web Speech API. 给 DSH 装上「免费、免 API key、开箱即用」的语音输入 + 回复朗读闭环（中文优先）。",
  "type": "module",
  "main": "./dsh/index.js",
  "exports": {
    ".": "./dsh/index.js",
    "./dsh": "./dsh/index.js",
    "./client": "./client/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dsh",
    "client",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "voice",
    "speech",
    "tts",
    "speech-recognition",
    "speech-synthesis",
    "voice-input",
    "read-aloud",
    "free",
    "zh-CN"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FuzzySoul/dsh-chatvoice.git"
  },
  "bugs": {
    "url": "https://github.com/FuzzySoul/dsh-chatvoice/issues"
  },
  "homepage": "https://github.com/FuzzySoul/dsh-chatvoice#readme",
  "author": "FuzzySoul",
  "devDependencies": {
    "puppeteer-core": "^25.7.0"
  },
  "scripts": {
    "e2e": "node scripts/e2e.mjs",
    "gif": "node scripts/gif.mjs"
  }
}
