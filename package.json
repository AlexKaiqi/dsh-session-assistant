{
  "name": "dsh-session-assistant",
  "version": "0.4.8",
  "description": "Session-scoped full-duplex voice assistant with tool-controlled drafting and Agent submission for DeepSeek Harness.",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "pnpm@11.22.0",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./typert": {
      "types": "./lib/types/typert-host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/types/typert-remote.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/*.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "INTRODUCTION.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs/design.md",
    "spec",
    "plugin-spec.json"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "voice",
    "speech",
    "tts",
    "speech-recognition",
    "speech-synthesis",
    "voice-input",
    "voice-workspace",
    "voice-agent",
    "openai-realtime",
    "doubao",
    "webrtc",
    "multilingual",
    "deliberation",
    "drafting",
    "free",
    "zh-CN"
  ],
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "zod": "^4.4.3"
  },
  "dsh": {
    "inventory": {
      "summary": {
        "zh": "与上下文感知模型双工语音讨论，通过独立修改操作维护可编辑草稿，定稿后再提交给主 Agent。",
        "en": "Hold a full-duplex contextual voice discussion, maintain an editable draft through separate mutations, and submit only after finalization."
      },
      "tags": [
        "voice",
        "realtime",
        "drafting",
        "productivity"
      ],
      "dependencies": [
        "dsh-multi-model-provider",
        "dsh-realtime-voice",
        "@deepseek-ai/dsh-settings",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "optionalDependencies": [
        "dsh-personal-knowledge-base"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "dsh-realtime-voice",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "author": "FuzzySoul",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlexKaiqi/dsh-session-assistant.git"
  },
  "bugs": {
    "url": "https://github.com/AlexKaiqi/dsh-session-assistant/issues"
  },
  "homepage": "https://github.com/AlexKaiqi/dsh-session-assistant#readme",
  "scripts": {
    "build": "npm run clean && tsc --project tsconfig.build.json && tsdown && node scripts/normalize-built-client.mjs",
    "clean": "node -e \"require('node:fs').rmSync('lib', { recursive: true, force: true })\"",
    "typecheck": "tsc --project tsconfig.json",
    "deps:check": "pnpm peers check",
    "test": "node --test test/*.test.mjs",
    "test:e2e:live": "DSH_SESSION_VOICE_E2E_LIVE=1 node --test test/live-product.e2e.mjs",
    "eval:check": "node evals/validate-suite.mjs",
    "pack:check": "node scripts/verify-package.mjs",
    "check": "npm run deps:check && npm run typecheck && npm run eval:check && npm run build && node --check test/live-product.e2e.mjs && npm test && npm run pack:check",
    "prepack": "npm run check"
  },
  "types": "./lib/types/index.d.ts",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-api-remotes": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-locale": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-runtime": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-settings": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1",
    "dsh-multi-model-provider": "^0.1.0-rc.11",
    "dsh-personal-knowledge-base": "^0.3.2",
    "dsh-realtime-voice": "^0.3.1",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "dsh-personal-knowledge-base": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-api-remotes": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-locale": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-runtime": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-settings": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@types/node": "^24.13.3",
    "@types/react": "^18.3.1",
    "dsh-multi-model-provider": "0.1.0-rc.11",
    "dsh-realtime-voice": "0.3.1",
    "playwright": "^1.62.1",
    "react": "^18.2.0",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "ws": "^8.18.3"
  }
}
