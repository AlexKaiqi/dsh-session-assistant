{
  "name": "dsh-chatvoice",
  "version": "0.3.0",
  "description": "ChatVoice — full-duplex contextual voice deliberation with tool-controlled editable drafting for DeepSeek Harness.",
  "type": "module",
  "main": "./dsh/index.js",
  "exports": {
    ".": "./dsh/index.js",
    "./dsh": "./dsh/index.js",
    "./client": "./client/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dsh",
    "client",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs",
    "README.en.md"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "voice",
    "speech",
    "tts",
    "speech-recognition",
    "speech-synthesis",
    "voice-input",
    "voice-workspace",
    "deliberation",
    "drafting",
    "read-aloud",
    "free",
    "zh-CN"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "ws": "^8.21.0"
  },
  "dsh": {
    "inventory": {
      "summary": {
        "zh": "与上下文感知模型双工语音讨论，通过独立修改操作维护可编辑草稿，定稿后再提交给主 Agent。",
        "en": "Hold a full-duplex contextual voice discussion, maintain an editable draft through separate mutations, and submit only after finalization."
      },
      "tags": ["voice", "realtime", "drafting", "productivity"],
      "dependencies": [
        "dsh-multi-model-provider",
        "@deepseek-ai/dsh-llm",
        "@deepseek-ai/dsh-settings",
        "@deepseek-ai/dsh-credentials"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FuzzySoul/dsh-chatvoice.git"
  },
  "bugs": {
    "url": "https://github.com/FuzzySoul/dsh-chatvoice/issues"
  },
  "homepage": "https://github.com/FuzzySoul/dsh-chatvoice#readme",
  "author": "FuzzySoul",
  "devDependencies": {
    "puppeteer-core": "^25.7.0"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "e2e": "node scripts/e2e.mjs",
    "gif": "node scripts/gif.mjs"
  }
}
